// require MT >= 2.26.10
// Author: pyanahida (AWGZYXDCZS)
// This is a highlight-file about HexLine-Lang
// Installing it within the MT manager allows you to enjoy code highlighting

// About: Tutorial -> https://mt.cc/guide/file/mt-syntax.html
{
    name: ["HexLine-Lang", ".hxl"]
    ignoreCase: true
    
    styles: [
        "encode" > "constant" @I
        "sign"   > "keyword"  @B
        "range"  > "label"    @B
    ]
    
    comment: {startsWith: "//"}
    
    defines: [
        // Match encodings
        "encode": {
            match: /(?<=using\s+)/ + keywordsToRegex(
                "utf-8 utf-16-le utf-16-be utf-32-le utf-32-be gbk windows-1252 iso-8859-1"
            )
            0: "encode"
        }
        // Number literal
        "number": {
            match: /\$-?[0-9A-Fa-f]+(.[0-9A-Fa-f]+)?/
            0: "number"
        }
        // Keywords
        "keyword": [
            // The "using" which at 1st line
            {
                match: /\Ausing\b/
                0: "keyword"
            }
            // Irregular
            {
                match: /(?<=\n\s*)/ + keywordsToRegex(
                    "def defstr del deli swap area endarea" +
                    "add sub mul div fdiv mod fmod pow ipow concatnum fact pol" +
                    "abs floor ceil round dot" +
                    "and or not xor nand nor xnor" +
                    "lg ln log2 log exp ten percent sn sqrt cbrt square cube root" +
                    "label goto" +
                    "loop endloop endif endwhile endif-else endelse" +
                    "defarr defstrarr append allclear exchange sum prod" +
                    "concat break continue" +
                    "digitsave shuffle"
                ) + /\b/
                0: "keyword"
            }
            // Judgements like ge, gt
            {
                match: /(?<=\n\s*)(if|while)-(lt|le|gt|ge|eq|ne|isTrue|isFalse)\b/
                0: "keyword"
            }
            // I
            {
                match: /(?<=\n\s*)print(num|decnum)?(ln)?\b/
                0: "keyword"
            }
            // O
            {
                match: /(?<=\n\s*)input(num|decnum)?\b/
                0: "keyword"
            }
            // Other inputs
            {
                match: /(?<=\n\s*)(inputstr|hinput(num|decnum|str))\b/
                0: "keyword"
            }
            // Code stop
            {
                match: /(?<=\n\s*)sleep-(s|ms|us|min|hour|day|week)\b/
                0: "keyword"
            }
            // Using math degree unit
            {
                match: /(?<=\n\s*)using(rad|deg|grad)\b/
                0: "keyword"
            }
            // Trigonometric function
            {
                match: /(?<=\n\s*)(/ + keywordsToRegex(
                    "sin sinh arcsin arsinh" +
                    "cos cosh arccos arcosh" +
                    "tan tanh arctan artanh" +
                    "cot coth arccot arcoth" +
                    "csc csch arccsc arcsch" +
                    "sec sech arcsec arsech"
                ) + /|(co|ha)?versin|ex(sec|csc))\b/
                0: "keyword"
            }
        ]
        // Match string
        "string": {
            start: {match: /"/, 0: "string"}
            end: {match: /"/, 0: "string"}
            style: "string"
            contains: [
                {match: /\\([\\"bantr]|x[0-9A-Za-z]{2})/, 0: "strEscape"} 
                {match: /\\./, 0: "error"} 
            ]
        }
        // Curly braces usually indicate parameter passing
        // "inputnum": {
        //     start: {match: /\{/, 0:"namespace"}
        //     end: {match: /\}/, 0:"namespace"}
        //     contains: [
        //         // Writing numbers here is allowed
        //         {include: "number"}
        //     ]
        // }
        // Methods of strings, numbers and arrays
        "method": {
            match: /(?<=[A-Za-z0-9_])(&/ + keywordsToRegex(
                // array
                "include findfirst join randitem" +
                // string
                "find divide toLowerCase toUpperCase fullmatch" +
                // number
                "toString" +
                // array & string
                "index len"
            ) + /)/
            1: "operator"
        }
        // Curly braces
        "brace": {
            match: /(?<=[A-Za-z0-9_\}])(\{)(.*?)(\})/
            1: "namespace"
            2: {include: "number"}
            2: {include: "string"}
            2: {include: "const"}
            3: "namespace"
        }
        // Keywords of constants
        "const": {
            match: keywordsToRegex(
                "TRUE FALSE"
                "PI E PHI GAMMA" +
                "RANDOM TIME RANDINT RANGE" +
                "SQRT2 SQRT3 SQRT5" +
                "LG2 LG3 LG7"
            )
            0: "type"
        }
        // The label of goto
        "label": {
            match: /#[a-zA-Z_][0-9a-zA-Z_]*\b/
            0: "label"
        }
        // Signs
        "sign": {
            match: /[+](?=\n)/
            0: "sign"
        }
        // Functions
        "func": [
            {
                match: /(user::)([0-9a-zA-Z_]+)\b/
                1: "range"
                2: "keyword2"
            }
            {
                start: {match: /(?<=\n)(func)\s+(%[A-Za-z0-9_]+)\b/, 1: "keyword", 2: "keyword2"}
                end: {match: /(?<=\n)endfunc/, 0: "keyword"}
                contains: [
                    {
                    match: /(\*|'|\*')(?=[A-Za-z0-9_])/
                    0: "sign"
                    }
                    {include: "string"}
                    {include: "number"}
                    {include: "encode"}
                    {include: "keyword"}
                    {include: "method"}
                    {include: "brace"}
                    {include: "const"}
                    {include: "label"}
                    {include: "sign"}
                ]
            }
        ]
    ]
    contains: [
        {include: "string"}
        {include: "number"}
        {include: "encode"}
        {include: "keyword"}
        {include: "method"}
        {include: "brace"}
        // {include: "inputnum"}
        {include: "const"}
        {include: "label"}
        {include: "sign"}
        {include: "func"}
    ]
}
